# Live mode — loaded by `npm run dev:live` (vite --mode live).
# Hits the real backend on :8000 through the vite proxy instead of replaying
# src/mocks. Committed on purpose (unlike .env, which is gitignored) so the
# live demo is one command. Out-ranks a stale .env because .env.<mode> has
# higher precedence than .env in Vite.
VITE_MOCK=0
