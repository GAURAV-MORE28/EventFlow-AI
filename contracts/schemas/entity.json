{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where an entity/edge came from (additive). `source`: osm | organizer | derived | synthetic_demo.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "inferred": {
          "default": false,
          "title": "Inferred",
          "type": "boolean"
        },
        "travel_time_confidence": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Travel Time Confidence"
        },
        "lanes_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lanes Source"
        }
      },
      "required": [
        "source",
        "confidence"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "venue",
        "zone",
        "transport_node",
        "transport_route",
        "road",
        "hotel",
        "parking",
        "gate",
        "emergency_facility"
      ],
      "title": "Entity Type",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "lat": {
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "title": "Lon",
      "type": "number"
    },
    "nominal_capacity": {
      "title": "Nominal Capacity",
      "type": "number"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "meta": {
      "title": "Meta",
      "type": "object"
    },
    "subtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtype"
    },
    "capacity_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capacity Source"
    },
    "capacity_confidence": {
      "anyOf": [
        {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capacity Confidence"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "entity_id",
    "entity_type",
    "display_name",
    "lat",
    "lon",
    "nominal_capacity"
  ],
  "title": "entity",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
