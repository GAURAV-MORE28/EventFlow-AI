{
  "$defs": {
    "HotelProperty": {
      "additionalProperties": false,
      "properties": {
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "cluster_entity_id": {
          "title": "Cluster Entity Id",
          "type": "string"
        },
        "zone": {
          "title": "Zone",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "budget",
                "midscale",
                "upscale",
                "luxury"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "accessible": {
          "title": "Accessible",
          "type": "boolean"
        },
        "price_per_night_paise": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Per Night Paise"
        },
        "rooms_total": {
          "title": "Rooms Total",
          "type": "integer"
        },
        "rooms_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rooms Source"
        },
        "rooms_confidence": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rooms Confidence"
        },
        "price_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Source"
        },
        "rooms_in_service": {
          "title": "Rooms In Service",
          "type": "integer"
        },
        "rooms_occupied": {
          "title": "Rooms Occupied",
          "type": "integer"
        },
        "rooms_available": {
          "title": "Rooms Available",
          "type": "integer"
        },
        "occupancy": {
          "title": "Occupancy",
          "type": "number"
        },
        "status": {
          "enum": [
            "available",
            "limited",
            "saturated"
          ],
          "title": "Status",
          "type": "string"
        },
        "transport_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Entity Id"
        },
        "transport_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Name"
        },
        "walk_to_transport_sec": {
          "title": "Walk To Transport Sec",
          "type": "integer"
        },
        "transport_utilisation": {
          "title": "Transport Utilisation",
          "type": "number"
        },
        "transport_closed": {
          "default": false,
          "title": "Transport Closed",
          "type": "boolean"
        },
        "transport_forecast_utilisation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Forecast Utilisation"
        },
        "venue_entity_id": {
          "title": "Venue Entity Id",
          "type": "string"
        },
        "travel_time_to_venue_sec": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Travel Time To Venue Sec"
        },
        "bed_capacity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bed Capacity"
        },
        "bed_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bed Source"
        },
        "effective_guest_capacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Guest Capacity"
        },
        "guest_capacity_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guest Capacity Source"
        },
        "baseline_rooms_occupied": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Rooms Occupied"
        },
        "event_rooms_occupied": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Rooms Occupied"
        },
        "event_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Guests"
        },
        "occupancy_baseline_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupancy Baseline Source"
        },
        "capacity_tags": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Tags"
        }
      },
      "required": [
        "property_id",
        "name",
        "cluster_entity_id",
        "zone",
        "lat",
        "lon",
        "accessible",
        "rooms_total",
        "rooms_in_service",
        "rooms_occupied",
        "rooms_available",
        "occupancy",
        "status",
        "walk_to_transport_sec",
        "transport_utilisation",
        "venue_entity_id"
      ],
      "title": "HotelProperty",
      "type": "object"
    },
    "HotelSummary": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "type": "integer",
          "title": "Properties"
        },
        "rooms_in_service": {
          "title": "Rooms In Service",
          "type": "integer"
        },
        "rooms_occupied": {
          "title": "Rooms Occupied",
          "type": "integer"
        },
        "rooms_available": {
          "title": "Rooms Available",
          "type": "integer"
        },
        "occupancy": {
          "title": "Occupancy",
          "type": "number"
        },
        "saturated": {
          "title": "Saturated",
          "type": "integer"
        },
        "limited": {
          "title": "Limited",
          "type": "integer"
        },
        "unmet_room_requests": {
          "title": "Unmet Room Requests",
          "type": "integer"
        },
        "effective_guest_capacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Guest Capacity"
        },
        "attendance_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendance Total"
        },
        "local_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Guests"
        },
        "lodging_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging Guests"
        },
        "lodging_requested_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging Requested Guests"
        },
        "lodging_allocated_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging Allocated Guests"
        },
        "lodging_unmet_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging Unmet Guests"
        },
        "lodging_pending_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging Pending Guests"
        },
        "lodging_in_house_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging In House Guests"
        },
        "lodging_checked_out_guests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lodging Checked Out Guests"
        },
        "default_lodging_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Lodging Share"
        },
        "guests_per_room": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guests Per Room"
        },
        "shortage_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shortage Message"
        }
      },
      "required": [
        "properties",
        "rooms_in_service",
        "rooms_occupied",
        "rooms_available",
        "occupancy",
        "saturated",
        "limited",
        "unmet_room_requests"
      ],
      "title": "HotelSummary",
      "type": "object"
    },
    "LodgingEvent": {
      "additionalProperties": false,
      "description": "One event's accommodation demand (people). lodging = allocated + unmet + pending.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "attendance": {
          "title": "Attendance",
          "type": "number"
        },
        "lodging_share": {
          "title": "Lodging Share",
          "type": "number"
        },
        "lodging_share_source": {
          "enum": [
            "event",
            "default"
          ],
          "title": "Lodging Share Source",
          "type": "string"
        },
        "lodging_guests": {
          "title": "Lodging Guests",
          "type": "number"
        },
        "local_guests": {
          "title": "Local Guests",
          "type": "number"
        },
        "requested_guests": {
          "title": "Requested Guests",
          "type": "number"
        },
        "allocated_guests": {
          "title": "Allocated Guests",
          "type": "number"
        },
        "unmet_guests": {
          "title": "Unmet Guests",
          "type": "number"
        },
        "pending_guests": {
          "title": "Pending Guests",
          "type": "number"
        },
        "in_house_guests": {
          "title": "In House Guests",
          "type": "number"
        },
        "checked_out_guests": {
          "title": "Checked Out Guests",
          "type": "number"
        },
        "hotel_origin_share": {
          "title": "Hotel Origin Share",
          "type": "number"
        },
        "cancelled": {
          "title": "Cancelled",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "name",
        "attendance",
        "lodging_share",
        "lodging_share_source",
        "lodging_guests",
        "local_guests",
        "requested_guests",
        "allocated_guests",
        "unmet_guests",
        "pending_guests",
        "in_house_guests",
        "checked_out_guests",
        "hotel_origin_share",
        "cancelled"
      ],
      "title": "LodgingEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sim_time": {
      "title": "Sim Time",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/HotelSummary"
    },
    "hotels": {
      "items": {
        "$ref": "#/$defs/HotelProperty"
      },
      "title": "Hotels",
      "type": "array"
    },
    "lodging_by_event": {
      "items": {
        "$ref": "#/$defs/LodgingEvent"
      },
      "title": "Lodging By Event",
      "type": "array"
    }
  },
  "required": [
    "sim_time",
    "summary",
    "hotels"
  ],
  "title": "hotel_list_response",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
