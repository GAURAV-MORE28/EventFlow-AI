{
  "$defs": {
    "Certificate": {
      "additionalProperties": false,
      "properties": {
        "certificate_id": {
          "title": "Certificate Id",
          "type": "string"
        },
        "intervention_id": {
          "title": "Intervention Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "STABLE",
            "CONDITIONAL",
            "UNSTABLE"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "iterations": {
          "title": "Iterations",
          "type": "integer"
        },
        "post_nudge_variance": {
          "title": "Post Nudge Variance",
          "type": "number"
        },
        "baseline_variance": {
          "title": "Baseline Variance",
          "type": "number"
        },
        "max_zone_utilisation": {
          "title": "Max Zone Utilisation",
          "type": "number"
        },
        "max_zone_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Zone Entity Id"
        },
        "oscillation_risk": {
          "title": "Oscillation Risk",
          "type": "boolean"
        },
        "compliance_sensitivity": {
          "title": "Compliance Sensitivity",
          "type": "number"
        },
        "compliance_sweep": {
          "items": {
            "$ref": "#/$defs/ComplianceSweepRow"
          },
          "title": "Compliance Sweep",
          "type": "array"
        },
        "reason": {
          "maxLength": 140,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "certificate_id",
        "intervention_id",
        "verdict",
        "converged",
        "iterations",
        "post_nudge_variance",
        "baseline_variance",
        "max_zone_utilisation",
        "oscillation_risk",
        "compliance_sensitivity",
        "compliance_sweep",
        "reason"
      ],
      "title": "Certificate",
      "type": "object"
    },
    "ComplianceSweepRow": {
      "additionalProperties": false,
      "properties": {
        "compliance_rate": {
          "title": "Compliance Rate",
          "type": "number"
        },
        "max_utilisation": {
          "title": "Max Utilisation",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "STABLE",
            "CONDITIONAL",
            "UNSTABLE"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "compliance_rate",
        "max_utilisation",
        "verdict"
      ],
      "title": "ComplianceSweepRow",
      "type": "object"
    },
    "InterventionEffect": {
      "additionalProperties": false,
      "description": "Live consequence of an executing action: the live city vs its do-nothing copy.",
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "utilisation": {
          "title": "Utilisation",
          "type": "number"
        },
        "counterfactual_utilisation": {
          "title": "Counterfactual Utilisation",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        }
      },
      "required": [
        "entity_id",
        "utilisation",
        "counterfactual_utilisation",
        "delta"
      ],
      "title": "InterventionEffect",
      "type": "object"
    },
    "InterventionEvaluation": {
      "additionalProperties": false,
      "description": "What simulating the candidate on a clone of the live city showed.",
      "properties": {
        "horizon_sec": {
          "title": "Horizon Sec",
          "type": "integer"
        },
        "compliance": {
          "title": "Compliance",
          "type": "number"
        },
        "root_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Entity Id"
        },
        "root_peak_before": {
          "title": "Root Peak Before",
          "type": "number"
        },
        "root_peak_after": {
          "title": "Root Peak After",
          "type": "number"
        },
        "network_peak_before": {
          "title": "Network Peak Before",
          "type": "number"
        },
        "network_peak_after": {
          "title": "Network Peak After",
          "type": "number"
        },
        "critical_before": {
          "title": "Critical Before",
          "type": "integer"
        },
        "critical_after": {
          "title": "Critical After",
          "type": "integer"
        },
        "new_critical_entities": {
          "items": {
            "type": "string"
          },
          "title": "New Critical Entities",
          "type": "array"
        },
        "people_redirected": {
          "default": 0,
          "title": "People Redirected",
          "type": "integer"
        },
        "travel_time_delta_sec": {
          "default": 0.0,
          "title": "Travel Time Delta Sec",
          "type": "number"
        },
        "rooms_unmet_delta": {
          "default": 0.0,
          "title": "Rooms Unmet Delta",
          "type": "number"
        }
      },
      "required": [
        "horizon_sec",
        "compliance",
        "root_peak_before",
        "root_peak_after",
        "network_peak_before",
        "network_peak_after",
        "critical_before",
        "critical_after"
      ],
      "title": "InterventionEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "intervention_id": {
      "title": "Intervention Id",
      "type": "string"
    },
    "intervention_type": {
      "enum": [
        "reroute_transport",
        "deploy_shuttle",
        "stagger_entry",
        "gate_redistribution",
        "parking_redistribution",
        "zone_incentive",
        "accommodation_rebalance",
        "emergency_corridor",
        "notify_only",
        "event_delay",
        "transport_redistribution"
      ],
      "title": "Intervention Type",
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "executing",
        "completed",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_entity_ids": {
      "items": {
        "type": "string"
      },
      "title": "Target Entity Ids",
      "type": "array"
    },
    "triggered_by_entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Triggered By Entity Id"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "estimated_relief_pct": {
      "title": "Estimated Relief Pct",
      "type": "number"
    },
    "estimated_cost_paise": {
      "title": "Estimated Cost Paise",
      "type": "integer"
    },
    "estimated_delay_sec": {
      "title": "Estimated Delay Sec",
      "type": "integer"
    },
    "feasibility": {
      "title": "Feasibility",
      "type": "number"
    },
    "rank_score": {
      "title": "Rank Score",
      "type": "number"
    },
    "certificate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Certificate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/InterventionEvaluation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "live_effect": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/InterventionEffect"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Live Effect"
    }
  },
  "required": [
    "intervention_id",
    "intervention_type",
    "status",
    "target_entity_ids",
    "title",
    "description",
    "estimated_relief_pct",
    "estimated_cost_paise",
    "estimated_delay_sec",
    "feasibility",
    "rank_score",
    "created_at",
    "expires_at"
  ],
  "title": "intervention",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
