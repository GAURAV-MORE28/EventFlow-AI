{
  "$defs": {
    "DepartureOption": {
      "additionalProperties": false,
      "properties": {
        "offset_sec": {
          "title": "Offset Sec",
          "type": "integer"
        },
        "depart_at": {
          "title": "Depart At",
          "type": "string"
        },
        "arrive_at": {
          "title": "Arrive At",
          "type": "string"
        },
        "travel_time_sec": {
          "title": "Travel Time Sec",
          "type": "integer"
        },
        "peak_utilisation": {
          "title": "Peak Utilisation",
          "type": "number"
        },
        "crowding_band": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "title": "Crowding Band",
          "type": "string"
        },
        "meets_event_start": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meets Event Start"
        },
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        }
      },
      "required": [
        "offset_sec",
        "depart_at",
        "arrive_at",
        "travel_time_sec",
        "peak_utilisation",
        "crowding_band"
      ],
      "title": "DepartureOption",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "legs": {
          "items": {
            "$ref": "#/$defs/RouteLeg"
          },
          "title": "Legs",
          "type": "array"
        },
        "total_duration_sec": {
          "title": "Total Duration Sec",
          "type": "integer"
        },
        "predicted_crowding_band": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "title": "Predicted Crowding Band",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "peak_utilisation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Utilisation"
        },
        "congestion_delay_sec": {
          "default": 0,
          "title": "Congestion Delay Sec",
          "type": "integer"
        },
        "depart_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depart At"
        }
      },
      "required": [
        "legs",
        "total_duration_sec",
        "predicted_crowding_band"
      ],
      "title": "Route",
      "type": "object"
    },
    "RouteLeg": {
      "additionalProperties": false,
      "properties": {
        "from_entity_id": {
          "title": "From Entity Id",
          "type": "string"
        },
        "to_entity_id": {
          "title": "To Entity Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "walk",
            "transit",
            "shuttle",
            "drive"
          ],
          "title": "Mode",
          "type": "string"
        },
        "duration_sec": {
          "title": "Duration Sec",
          "type": "integer"
        }
      },
      "required": [
        "from_entity_id",
        "to_entity_id",
        "mode",
        "duration_sec"
      ],
      "title": "RouteLeg",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "journey_risk_score": {
      "title": "Journey Risk Score",
      "type": "integer"
    },
    "journey_risk_band": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "title": "Journey Risk Band",
      "type": "string"
    },
    "recommended_route": {
      "$ref": "#/$defs/Route"
    },
    "shortest_route": {
      "$ref": "#/$defs/Route"
    },
    "advice": {
      "title": "Advice",
      "type": "string"
    },
    "priority": {
      "anyOf": [
        {
          "enum": [
            "fastest",
            "balanced",
            "least_crowded"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Priority"
    },
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Route"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "departure_options": {
      "items": {
        "$ref": "#/$defs/DepartureOption"
      },
      "title": "Departure Options",
      "type": "array"
    },
    "recommended_departure_offset_sec": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Departure Offset Sec"
    },
    "departure_advice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Departure Advice"
    },
    "return_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/Route"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event"
    },
    "avoided_entity_ids": {
      "items": {
        "type": "string"
      },
      "title": "Avoided Entity Ids",
      "type": "array"
    },
    "transport_preference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transport Preference"
    },
    "preference_met": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preference Met"
    }
  },
  "required": [
    "journey_risk_score",
    "journey_risk_band",
    "recommended_route",
    "shortest_route",
    "advice"
  ],
  "title": "journey_response",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
