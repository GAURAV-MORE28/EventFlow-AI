{
  "$defs": {
    "EntityState": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "sim_time": {
          "title": "Sim Time",
          "type": "string"
        },
        "current_count": {
          "title": "Current Count",
          "type": "number"
        },
        "utilisation": {
          "title": "Utilisation",
          "type": "number"
        },
        "flow_rate_per_min": {
          "title": "Flow Rate Per Min",
          "type": "number"
        },
        "risk_score": {
          "title": "Risk Score",
          "type": "integer"
        },
        "risk_band": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "title": "Risk Band",
          "type": "string"
        },
        "is_observed": {
          "title": "Is Observed",
          "type": "boolean"
        },
        "inflow_per_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inflow Per Min"
        },
        "outflow_per_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outflow Per Min"
        },
        "queue_people": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue People"
        }
      },
      "required": [
        "entity_id",
        "sim_time",
        "current_count",
        "utilisation",
        "flow_rate_per_min",
        "risk_score",
        "risk_band",
        "is_observed"
      ],
      "title": "EntityState",
      "type": "object"
    },
    "StateSummary": {
      "additionalProperties": false,
      "properties": {
        "overall_risk_score": {
          "title": "Overall Risk Score",
          "type": "integer"
        },
        "overall_risk_band": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "title": "Overall Risk Band",
          "type": "string"
        },
        "critical_count": {
          "title": "Critical Count",
          "type": "integer"
        },
        "high_count": {
          "title": "High Count",
          "type": "integer"
        },
        "load_variance": {
          "title": "Load Variance",
          "type": "number"
        }
      },
      "required": [
        "overall_risk_score",
        "overall_risk_band",
        "critical_count",
        "high_count",
        "load_variance"
      ],
      "title": "StateSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sim_time": {
      "title": "Sim Time",
      "type": "string"
    },
    "cycle_number": {
      "title": "Cycle Number",
      "type": "integer"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntityState"
      },
      "title": "Entities",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/StateSummary"
    }
  },
  "required": [
    "sim_time",
    "cycle_number",
    "entities",
    "summary"
  ],
  "title": "state_response",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
